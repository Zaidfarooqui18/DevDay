APP_NAME=DevDay
APP_ENV=development
APP_URL=http://localhost:8000
APP_SECRET=devday_super_secret_key_change_in_production_9981

# Database Configuration
# Supported drivers: mysql, sqlite
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=devday
DB_USERNAME=root
DB_PASSWORD=
DB_SQLITE_PATH=database/devday.sqlite

# SMTP Configuration (PHPMailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=reports@devday.local
SMTP_FROM_NAME="DevDay Work Reports"
